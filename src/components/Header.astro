---
interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;
---

<header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-primary/10 px-6 md:px-20 py-6 bg-background-light/80 backdrop-blur-md sticky top-0 z-50">
    <a href="/" class="flex items-center gap-4">
        <div class="text-primary">
            <span class="material-symbols-outlined text-3xl">photo_camera</span>
        </div>
        <h2 class="text-xl font-medium tracking-tight">Foto-terapel.nl</h2>
    </a>
    <nav aria-label="Hoofdnavigatie" class="hidden md:flex items-center gap-12">
        <a class:list={["text-sm font-medium hover:text-primary transition-colors uppercase tracking-widest", { "text-primary": activePage === "portfolio" }]} href="/portfolio">Portfolio</a>
        <a class:list={["text-sm font-medium hover:text-primary transition-colors uppercase tracking-widest", { "text-primary": activePage === "over-mij" }]} href="/over-mij">Over mij</a>
        <a class:list={["text-sm font-medium hover:text-primary transition-colors uppercase tracking-widest", { "text-primary": activePage === "tarieven" }]} href="/tarieven">Tarieven</a>
        <a class:list={["text-sm font-medium hover:text-primary transition-colors uppercase tracking-widest", { "text-primary": activePage === "contact" }]} href="/contact">Contact</a>
    </nav>
    <div class="flex gap-4">
        <a href="/portfolio" aria-label="Portfolio bekijken" class="hidden md:flex items-center justify-center rounded-full size-10 bg-primary/10 hover:bg-primary/20 text-slate-900 transition-all">
            <span class="material-symbols-outlined text-[20px]">camera_roll</span>
        </a>
        <a href="/contact" aria-label="Contact opnemen" class="hidden md:flex items-center justify-center rounded-full size-10 bg-primary/10 hover:bg-primary/20 text-slate-900 transition-all">
            <span class="material-symbols-outlined text-[20px]">mail</span>
        </a>
        <button type="button" aria-label="Menu openen" id="mobile-menu-btn" class="md:hidden flex items-center justify-center rounded-full size-10 bg-primary/10 hover:bg-primary/20 text-slate-900 transition-all">
            <span class="material-symbols-outlined text-[20px]">menu</span>
        </button>
    </div>
</header>

<!-- Mobile menu -->
<nav id="mobile-menu" aria-label="Mobiele navigatie" class="hidden md:hidden fixed inset-0 z-40 bg-background-light/95 backdrop-blur-md flex flex-col items-center justify-center gap-8">
    <button type="button" aria-label="Menu sluiten" id="mobile-menu-close" class="absolute top-6 right-6 flex items-center justify-center rounded-full size-10 bg-primary/10 hover:bg-primary/20 text-slate-900 transition-all">
        <span class="material-symbols-outlined text-[20px]">close</span>
    </button>
    <a class="text-2xl font-light tracking-widest uppercase hover:text-primary transition-colors" href="/">Home</a>
    <a class="text-2xl font-light tracking-widest uppercase hover:text-primary transition-colors" href="/portfolio">Portfolio</a>
    <a class="text-2xl font-light tracking-widest uppercase hover:text-primary transition-colors" href="/over-mij">Over mij</a>
    <a class="text-2xl font-light tracking-widest uppercase hover:text-primary transition-colors" href="/tarieven">Tarieven</a>
    <a class="text-2xl font-light tracking-widest uppercase hover:text-primary transition-colors" href="/contact">Contact</a>
</nav>

<script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('mobile-menu-close');

    btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
    });

    closeBtn?.addEventListener('click', () => {
        menu?.classList.add('hidden');
    });
</script>
