---

---

<section class="grid md:grid-cols-2 gap-12 bg-zinc-900/50 p-8 md:p-12 rounded-2xl border border-gray-800">
    <div class="space-y-6">
        <h2 class="text-3xl font-serif font-semibold text-[#8B5E3C]">CONTACT</h2>
        <div class="flex items-center gap-3 text-gray-300 hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <span>Foto-TerApel</span>
        </div>
        <div class="flex items-center gap-3 text-gray-300 hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            <span>Foto-TerApel</span>
        </div>

        <p class="text-sm text-gray-400 pt-6">
            Vragen over prints of shoots? <a href="#" class="text-[#8B5E3C] hover:underline">Neem contact op.</a>
        </p>
        <div class="flex items-center gap-2 text-gray-500 pt-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            <span class="text-sm">Binnenkort: Webshop & Boekingen</span>
        </div>
    </div>

    <form class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="naam" class="sr-only">Naam</label>
                <input type="text" id="naam" name="naam" placeholder="Naam" class="w-full px-4 py-3 bg-[#1A1A1A] border border-gray-800 rounded-lg text-white placeholder-gray-600 focus:border-[#8B5E3C] focus:ring-1 focus:ring-[#8B5E3C]"/>
            </div>
            <div>
                <label for="email" class="sr-only">E-mail</label>
                <input type="email" id="email" name="email" placeholder="E-mail" class="w-full px-4 py-3 bg-[#1A1A1A] border border-gray-800 rounded-lg text-white placeholder-gray-600 focus:border-[#8B5E3C] focus:ring-1 focus:ring-[#8B5E3C]"/>
            </div>
        </div>
        <div>
            <label for="bericht" class="sr-only">Bericht</label>
            <textarea id="bericht" name="bericht" placeholder="Bericht" rows="6" class="w-full px-4 py-3 bg-[#1A1A1A] border border-gray-800 rounded-lg text-white placeholder-gray-600 focus:border-[#8B5E3C] focus:ring-1 focus:ring-[#8B5E3C]"></textarea>
        </div>
        <button type="submit" class="w-full bg-[#8B5E3C] text-white px-8 py-3 rounded-lg font-semibold hover:bg-[#A67554] transition shadow-lg">
            STUUR BERICHT
        </button>
    </form>
</section>
