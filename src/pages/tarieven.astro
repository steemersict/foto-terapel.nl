---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tarieven & Pakketten | Foto Terapel" description="Transparante prijzen voor tijdloze herinneringen. Van fine-art prints tot interactieve workshops in de natuur.">
    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <Header activePage="tarieven" />

            <main class="flex-1 flex flex-col items-center">
                <div class="max-w-[1200px] w-full px-6 py-12 lg:py-20 flex flex-col gap-16">
                    <!-- Hero Section -->
                    <div class="flex flex-col md:flex-row justify-between items-end gap-6 border-l-4 border-primary pl-6">
                        <div class="flex flex-col gap-4 max-w-2xl">
                            <h1 class="text-5xl lg:text-6xl font-black leading-tight tracking-tight">Tarieven &amp; Pakketten</h1>
                            <p class="text-slate-600 text-lg lg:text-xl font-normal max-w-lg">
                                Transparante prijzen voor tijdloze herinneringen. Van fine-art prints tot interactieve workshops in de natuur.
                            </p>
                        </div>
                        <button class="flex items-center gap-2 px-6 py-3 bg-primary/10 border border-primary/20 hover:bg-primary/20 rounded-lg text-slate-900 transition-colors">
                            <span class="material-symbols-outlined text-xl">download</span>
                            <span class="font-bold text-sm">Download Prijslijst</span>
                        </button>
                    </div>

                    <!-- Pricing Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <!-- Print Package -->
                        <div class="flex flex-col gap-6 rounded-xl border border-primary/20 bg-white p-8 transition-transform hover:-translate-y-1 shadow-sm">
                            <div class="flex flex-col gap-2">
                                <div class="flex items-center justify-between">
                                    <h3 class="text-xl font-bold">Landschap Print</h3>
                                    <span class="text-[10px] font-bold uppercase tracking-widest rounded-full bg-primary/20 px-3 py-1 text-slate-900">Limited</span>
                                </div>
                                <div class="flex items-baseline gap-1 mt-2">
                                    <span class="text-4xl font-black text-primary">€45</span>
                                    <span class="text-slate-500 text-sm italic">per print</span>
                                </div>
                            </div>
                            <hr class="border-primary/10" />
                            <ul class="flex flex-col gap-4 flex-grow">
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">check_circle</span>
                                    <span>Gedrukt op Fine-Art papier</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">check_circle</span>
                                    <span>Formaten tot A3+ beschikbaar</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">check_circle</span>
                                    <span>Gesigneerd &amp; Genummerd</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">check_circle</span>
                                    <span>Inclusief kokerverzending</span>
                                </li>
                            </ul>
                            <button class="w-full py-3 bg-slate-100 hover:bg-primary hover:text-slate-900 rounded-lg font-bold text-sm transition-all">
                                Bestel Print
                            </button>
                        </div>

                        <!-- Shoot Package - Featured -->
                        <div class="flex flex-col gap-6 rounded-xl border-2 border-primary bg-primary/5 p-8 transition-transform hover:-translate-y-1 shadow-xl relative overflow-hidden">
                            <div class="absolute top-0 right-0">
                                <div class="bg-primary text-slate-900 text-[10px] font-bold py-1 px-8 rotate-45 translate-x-6 translate-y-2">POPULAIR</div>
                            </div>
                            <div class="flex flex-col gap-2">
                                <h3 class="text-xl font-bold">Fotoshoot op Locatie</h3>
                                <div class="flex items-baseline gap-1 mt-2">
                                    <span class="text-5xl font-black text-primary">€150</span>
                                    <span class="text-slate-500 text-sm italic">per sessie</span>
                                </div>
                            </div>
                            <hr class="border-primary/20" />
                            <ul class="flex flex-col gap-4 flex-grow">
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">verified</span>
                                    <span>90 minuten pure fotografie</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">verified</span>
                                    <span>10 volledig nabewerkte beelden</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">verified</span>
                                    <span>Persoonlijke online galerij</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">verified</span>
                                    <span>Locatieadvies in de regio</span>
                                </li>
                            </ul>
                            <button class="w-full py-4 bg-primary text-slate-900 rounded-lg font-black text-sm transition-all hover:scale-[1.02]">
                                Boek Sessie
                            </button>
                        </div>

                        <!-- Workshop Package -->
                        <div class="flex flex-col gap-6 rounded-xl border border-primary/20 bg-white p-8 transition-transform hover:-translate-y-1 shadow-sm">
                            <div class="flex flex-col gap-2">
                                <h3 class="text-xl font-bold">Fotografie Workshop</h3>
                                <div class="flex items-baseline gap-1 mt-2">
                                    <span class="text-4xl font-black text-primary">€89</span>
                                    <span class="text-slate-500 text-sm italic">p.p.</span>
                                </div>
                            </div>
                            <hr class="border-primary/10" />
                            <ul class="flex flex-col gap-4 flex-grow">
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">school</span>
                                    <span>4 uur praktijk in het veld</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">school</span>
                                    <span>Focus op licht &amp; compositie</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">school</span>
                                    <span>Kleine groepen (max 5 pers)</span>
                                </li>
                                <li class="flex items-center gap-3 text-sm">
                                    <span class="material-symbols-outlined text-primary text-lg">school</span>
                                    <span>Inclusief veldgids PDF</span>
                                </li>
                            </ul>
                            <button class="w-full py-3 bg-slate-100 hover:bg-primary hover:text-slate-900 rounded-lg font-bold text-sm transition-all">
                                Schrijf In
                            </button>
                        </div>
                    </div>

                    <!-- Additional Options -->
                    <div class="flex flex-col gap-8">
                        <div class="flex items-center gap-4">
                            <h2 class="text-2xl font-bold tracking-tight">Extra Opties</h2>
                            <div class="h-px flex-1 bg-primary/20"></div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            <div class="group flex flex-col gap-4 rounded-xl border border-primary/10 bg-primary/5 p-6 hover:bg-primary transition-all duration-300">
                                <span class="material-symbols-outlined text-3xl text-primary group-hover:text-slate-900">magic_button</span>
                                <div>
                                    <h4 class="font-bold text-slate-900 group-hover:text-slate-900">Extra Edit</h4>
                                    <p class="text-sm text-slate-600 group-hover:text-slate-800">€15 per extra foto</p>
                                </div>
                            </div>
                            <div class="group flex flex-col gap-4 rounded-xl border border-primary/10 bg-primary/5 p-6 hover:bg-primary transition-all duration-300">
                                <span class="material-symbols-outlined text-3xl text-primary group-hover:text-slate-900">speed</span>
                                <div>
                                    <h4 class="font-bold text-slate-900 group-hover:text-slate-900">Spoedlevering</h4>
                                    <p class="text-sm text-slate-600 group-hover:text-slate-800">Binnen 24u: €50</p>
                                </div>
                            </div>
                            <div class="group flex flex-col gap-4 rounded-xl border border-primary/10 bg-primary/5 p-6 hover:bg-primary transition-all duration-300">
                                <span class="material-symbols-outlined text-3xl text-primary group-hover:text-slate-900">distance</span>
                                <div>
                                    <h4 class="font-bold text-slate-900 group-hover:text-slate-900">Reiskosten</h4>
                                    <p class="text-sm text-slate-600 group-hover:text-slate-800">€0,35 per km (&gt;20km)</p>
                                </div>
                            </div>
                            <div class="group flex flex-col gap-4 rounded-xl border border-primary/10 bg-primary/5 p-6 hover:bg-primary transition-all duration-300">
                                <span class="material-symbols-outlined text-3xl text-primary group-hover:text-slate-900">menu_book</span>
                                <div>
                                    <h4 class="font-bold text-slate-900 group-hover:text-slate-900">Fotoalbum</h4>
                                    <p class="text-sm text-slate-600 group-hover:text-slate-800">Vanaf €120 (Handgemaakt)</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Visual CTA Section -->
                    <div class="rounded-xl overflow-hidden relative h-[400px] flex items-center justify-center group">
                        <div class="absolute inset-0 bg-gradient-to-br from-[#4a5d3e] via-[#2d3a2e] to-[#1a1b17] transition-transform duration-700 group-hover:scale-105"></div>
                        <div class="absolute inset-0 bg-slate-900/40"></div>
                        <div class="relative text-center px-4 max-w-2xl">
                            <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4 italic">"Leg het onzichtbare vast in elk moment."</h2>
                            <p class="text-slate-200 text-lg">Klaar om jouw verhaal te vertellen door mijn lens?</p>
                            <a href="/contact" class="mt-8 px-10 py-4 bg-primary text-slate-900 font-bold rounded-lg hover:scale-105 transition-transform inline-block">
                                Plan een kennismaking
                            </a>
                        </div>
                    </div>
                </div>
            </main>

            <!-- Footer -->
            <footer class="border-t border-primary/10 py-12 px-6 lg:px-20 bg-white">
                <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
                    <div class="flex flex-col gap-4">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">photo_camera</span>
                            <span class="text-lg font-bold">Foto Terapel</span>
                        </div>
                        <p class="text-sm text-slate-500">Professionele landschaps- en portretfotografie met oog voor detail en emotie.</p>
                    </div>
                    <div>
                        <h5 class="font-bold mb-4">Navigatie</h5>
                        <ul class="flex flex-col gap-2 text-sm text-slate-600">
                            <li><a class="hover:text-primary" href="/portfolio">Portfolio</a></li>
                            <li><a class="hover:text-primary" href="/over-mij">Over Mij</a></li>
                            <li><a class="hover:text-primary" href="/tarieven">Tarieven</a></li>
                            <li><a class="hover:text-primary" href="/contact">Contact</a></li>
                        </ul>
                    </div>
                    <div>
                        <h5 class="font-bold mb-4">Support</h5>
                        <ul class="flex flex-col gap-2 text-sm text-slate-600">
                            <li><a class="hover:text-primary" href="#">Veelgestelde vragen</a></li>
                            <li><a class="hover:text-primary" href="#">Algemene voorwaarden</a></li>
                            <li><a class="hover:text-primary" href="#">Privacy Policy</a></li>
                            <li><a class="hover:text-primary" href="/contact">Contact</a></li>
                        </ul>
                    </div>
                    <div>
                        <h5 class="font-bold mb-4">Volg mij</h5>
                        <div class="flex gap-4">
                            <a class="size-8 rounded-lg bg-primary/10 flex items-center justify-center hover:bg-primary transition-colors" href="#" aria-label="Instagram">
                                <span class="material-symbols-outlined text-lg">camera</span>
                            </a>
                            <a class="size-8 rounded-lg bg-primary/10 flex items-center justify-center hover:bg-primary transition-colors" href="#" aria-label="Website">
                                <span class="material-symbols-outlined text-lg">public</span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="max-w-[1200px] mx-auto mt-12 pt-8 border-t border-primary/5 text-center text-xs text-slate-500">
                    &copy; {new Date().getFullYear()} Foto Terapel. Alle rechten voorbehouden.
                </div>
            </footer>
        </div>
    </div>
</Layout>
