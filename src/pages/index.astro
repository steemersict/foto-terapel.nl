---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Foto-terapel.nl | Landschapsfotografie uit het Noorden">
    <div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
        <div class="layout-container flex h-full grow flex-col">
            <Header activePage="home" />

            <main class="flex-1">
                <!-- Hero Section -->
                <section class="relative h-[85vh] w-full flex items-center justify-center overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-[#2d3a2e] via-[#4a5d3e] to-[#1a1b17] transition-transform duration-1000 scale-105">
                        <div class="absolute inset-0 bg-gradient-to-b from-black/20 to-black/40"></div>
                    </div>
                    <div class="relative z-10 text-center px-4 max-w-4xl">
                        <h1 class="text-white text-6xl md:text-8xl font-light mb-6 tracking-tighter italic">
                            Foto-terapel.nl
                        </h1>
                        <p class="text-white/90 text-lg md:text-xl font-light tracking-wide max-w-2xl mx-auto border-t border-white/20 pt-6">
                            De schoonheid van het noorden, vastgelegd in licht en sfeer.
                        </p>
                        <div class="mt-12">
                            <a href="/portfolio" class="px-10 py-4 bg-white/10 hover:bg-white/20 border border-white/30 backdrop-blur-sm text-white text-sm uppercase tracking-[0.3em] transition-all rounded inline-block">
                                Ontdek de collectie
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Photographer's Note -->
                <section class="py-24 px-6 md:px-20 text-center max-w-3xl mx-auto">
                    <span class="material-symbols-outlined text-primary/40 text-4xl mb-6 block">format_quote</span>
                    <p class="font-handwriting text-3xl md:text-4xl text-slate-700 leading-relaxed">
                        "Elke foto vertelt een verhaal van een moment dat nooit meer precies zo terugkomt."
                    </p>
                    <div class="w-12 h-[1px] bg-primary mx-auto mt-12"></div>
                </section>

                <!-- Portfolio Bento Grid -->
                <section class="px-6 md:px-20 pb-32">
                    <div class="bento-grid">
                        <!-- Category 1: Mist & Sfeer (Large) -->
                        <div class="md:col-span-2 md:row-span-2 group relative overflow-hidden rounded-xl cursor-pointer">
                            <div class="absolute inset-0 bg-gradient-to-br from-[#4a5d3e]/80 via-[#2d3a2e] to-[#1a1b17] transition-transform duration-700 group-hover:scale-110"></div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
                            <div class="absolute bottom-8 left-8">
                                <h3 class="text-white text-2xl font-light tracking-widest uppercase">Mist &amp; Sfeer</h3>
                                <p class="text-white/70 text-sm mt-2 font-light">De stille ochtend in de Drentse velden</p>
                            </div>
                        </div>
                        <!-- Category 2: Vorst & Winter -->
                        <div class="md:col-span-2 md:row-span-1 group relative overflow-hidden rounded-xl cursor-pointer">
                            <div class="absolute inset-0 bg-gradient-to-br from-[#8ba3b1] via-[#6b8a9e] to-[#3d5a6e] transition-transform duration-700 group-hover:scale-110"></div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
                            <div class="absolute bottom-6 left-6">
                                <h3 class="text-white text-xl font-light tracking-widest uppercase">Vorst &amp; Winter</h3>
                            </div>
                        </div>
                        <!-- Category 3: Wijde Landschappen -->
                        <div class="md:col-span-1 md:row-span-1 group relative overflow-hidden rounded-xl cursor-pointer">
                            <div class="absolute inset-0 bg-gradient-to-br from-[#a3b18b] via-[#7a9468] to-[#3d5a2e] transition-transform duration-700 group-hover:scale-110"></div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
                            <div class="absolute bottom-6 left-6">
                                <h3 class="text-white text-lg font-light tracking-widest uppercase leading-tight">Wijde<br/>Landschappen</h3>
                            </div>
                        </div>
                        <!-- Category 4: Detail & Macro -->
                        <div class="md:col-span-1 md:row-span-1 group relative overflow-hidden rounded-xl cursor-pointer">
                            <div class="absolute inset-0 bg-gradient-to-br from-[#6b7a5e] via-[#4a5d3e] to-[#2d3a2e] transition-transform duration-700 group-hover:scale-110"></div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
                            <div class="absolute bottom-6 left-6">
                                <h3 class="text-white text-lg font-light tracking-widest uppercase leading-tight">Detail &amp;<br/>Macro</h3>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Subtle Contact Section -->
                <section class="bg-primary/5 py-32 px-6">
                    <div class="max-w-xl mx-auto text-center">
                        <h2 class="text-3xl font-light tracking-tight mb-4">Samen een moment vastleggen?</h2>
                        <p class="text-slate-500 mb-12 font-light">Voor opdrachten, prints of gewoon een praatje.</p>
                        <form class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="relative">
                                    <label for="home-naam" class="sr-only">Naam</label>
                                    <input class="w-full bg-transparent border-0 border-b border-primary/30 focus:border-primary focus:ring-0 py-3 px-0 font-light text-sm placeholder:text-slate-400 placeholder:uppercase placeholder:tracking-widest" id="home-naam" placeholder="Naam" type="text" />
                                </div>
                                <div class="relative">
                                    <label for="home-email" class="sr-only">E-mail</label>
                                    <input class="w-full bg-transparent border-0 border-b border-primary/30 focus:border-primary focus:ring-0 py-3 px-0 font-light text-sm placeholder:text-slate-400 placeholder:uppercase placeholder:tracking-widest" id="home-email" placeholder="E-mail" type="email" />
                                </div>
                            </div>
                            <div class="pt-8">
                                <button class="group flex items-center justify-center gap-4 mx-auto text-sm uppercase tracking-[0.3em] font-medium py-2 border-b-2 border-primary hover:text-primary transition-all" type="submit">
                                    Verstuur bericht
                                    <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </section>
            </main>

            <Footer />
        </div>
    </div>
</Layout>
