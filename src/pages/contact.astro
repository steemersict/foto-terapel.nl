---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | Foto Terapel" description="Neem contact op voor een fotoshoot, prints of gewoon een praatje. Studio in Ter Apel, Nederland.">
    <div class="layout-container flex h-full grow flex-col">
        <Header activePage="contact" />

        <main class="flex-1 max-w-6xl mx-auto w-full px-6 py-12 md:py-24">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
                <!-- Contact Info Section -->
                <div class="flex flex-col gap-10">
                    <div class="flex flex-col gap-4">
                        <h1 class="text-5xl md:text-6xl font-black leading-tight tracking-tight text-slate-900">
                            Laten we jouw <br/><span class="text-primary italic">verhaal vastleggen.</span>
                        </h1>
                        <p class="text-slate-600 text-lg max-w-md">
                            Of het nu gaat om een portretsessie, een bruiloft of een commercieel project — ik breng jouw visie tot leven.
                        </p>
                    </div>
                    <div class="flex flex-col gap-6">
                        <div class="flex items-center gap-4 group">
                            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-all">
                                <span class="material-symbols-outlined">mail</span>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-widest text-slate-500 font-bold">E-mail</p>
                                <p class="text-lg font-medium">hello@foto-terapel.nl</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 group">
                            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-all">
                                <span class="material-symbols-outlined">location_on</span>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-widest text-slate-500 font-bold">Studio</p>
                                <p class="text-lg font-medium">Ter Apel, Nederland</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 group cursor-pointer">
                            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-all">
                                <span class="material-symbols-outlined">share</span>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-widest text-slate-500 font-bold">Socials</p>
                                <p class="text-lg font-medium">@fototerapel_nl</p>
                            </div>
                        </div>
                    </div>
                    <!-- Camera image placeholder -->
                    <div class="mt-4 rounded-xl overflow-hidden h-64 w-full grayscale hover:grayscale-0 transition-all duration-700">
                        <div class="w-full h-full bg-gradient-to-br from-slate-400 via-slate-500 to-slate-700 flex items-center justify-center text-white/60 text-sm">
                            Camera setup foto binnenkort beschikbaar
                        </div>
                    </div>
                </div>

                <!-- Contact Form Section -->
                <div class="bg-white border border-primary/10 p-8 md:p-12 rounded-xl shadow-sm">
                    <form class="flex flex-col gap-6">
                        <div class="flex flex-col gap-2">
                            <label for="contact-naam" class="text-sm font-bold uppercase tracking-wider text-slate-500">Naam</label>
                            <input class="w-full rounded border-slate-200 bg-transparent py-4 px-4 focus:border-primary focus:ring-1 focus:ring-primary transition-all text-slate-900" id="contact-naam" placeholder="Jouw volledige naam" type="text" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label for="contact-email" class="text-sm font-bold uppercase tracking-wider text-slate-500">E-mailadres</label>
                            <input class="w-full rounded border-slate-200 bg-transparent py-4 px-4 focus:border-primary focus:ring-1 focus:ring-primary transition-all text-slate-900" id="contact-email" placeholder="voorbeeld@domein.nl" type="email" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label for="contact-onderwerp" class="text-sm font-bold uppercase tracking-wider text-slate-500">Onderwerp</label>
                            <select class="w-full rounded border-slate-200 bg-transparent py-4 px-4 focus:border-primary focus:ring-1 focus:ring-primary transition-all text-slate-900 appearance-none" id="contact-onderwerp">
                                <option>Portretsessie</option>
                                <option>Bruiloftfotografie</option>
                                <option>Commerciële Shoot</option>
                                <option>Overige Vraag</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label for="contact-bericht" class="text-sm font-bold uppercase tracking-wider text-slate-500">Bericht</label>
                            <textarea class="w-full rounded border-slate-200 bg-transparent py-4 px-4 focus:border-primary focus:ring-1 focus:ring-primary transition-all text-slate-900 resize-none" id="contact-bericht" placeholder="Hoe kan ik je helpen?" rows="4"></textarea>
                        </div>
                        <button class="mt-4 w-full bg-primary hover:bg-primary/90 text-white font-bold py-5 rounded-lg transition-all flex items-center justify-center gap-2 group" type="submit">
                            <span>Verstuur Bericht</span>
                            <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform">send</span>
                        </button>
                    </form>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="border-t border-primary/10 py-10 bg-background-light">
            <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
                <p class="text-slate-500 text-sm">&copy; {new Date().getFullYear()} foto-terapel.nl. Alle rechten voorbehouden.</p>
                <div class="flex gap-6">
                    <a class="text-slate-400 hover:text-primary transition-colors" href="#" aria-label="Instagram">
                        <span class="material-symbols-outlined">camera</span>
                    </a>
                    <a class="text-slate-400 hover:text-primary transition-colors" href="#" aria-label="Portfolio">
                        <span class="material-symbols-outlined">video_library</span>
                    </a>
                </div>
            </div>
        </footer>
    </div>
</Layout>
